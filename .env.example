# Server-only values. Never commit real credentials or use NEXT_PUBLIC_ prefixes.
ALPHA_BASIC_USER=alpha
ALPHA_BASIC_PASSWORD=change-to-a-long-random-password

# Google OAuth 2.0 web client. Register /api/auth/google/callback as a redirect URI.
# Use your actual HTTPS origin in production.
MONSTERA_PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact URL registered in the staging Google Web OAuth client, not a browser-provided redirect.
MONSTERA_EXPECTED_GOOGLE_REDIRECT_URI=
# At least 32 random UTF-8 bytes; rotate only with explicit approval.
MONSTERA_SESSION_SECRET=

# Neon PostgreSQL; leave unset in CI build or when DB is unavailable.
DATABASE_URL=

# AI providers (server-side only).
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
ALPHA_MODEL_ID=

# Explicitly opt in to rate-limited, zero-price-model alpha chat only.
# If absent/false, chat returns BILLING_POLICY_NOT_CONFIGURED.
MONSTERA_FREE_CHAT_ENABLED=false
# Comma-separated exact provider:upstream_model_id entries, approved by the operator.
# A zero registry price does NOT mean the upstream call is free.
MONSTERA_ALPHA_APPROVED_MODELS=
# Required positive global max calls per UTC day (1..1000). Not a dollar-spend cap.
MONSTERA_ALPHA_DAILY_REQUEST_CAP=0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Isolated namespace per environment; never share staging and production counters.
MONSTERA_REDIS_NAMESPACE=
# Required for even a private-alpha provider call. ONLY set true after a verified
# provider-side hard spending cap is configured; this flag alone cannot enforce it.
MONSTERA_PROVIDER_SPENDING_LIMIT_CONFIRMED=false
# Strict operator-maintained JSON array with provider, model, integer USD-micro per
# 1M input/output tokens, conservative input/output token ceilings and reviewedAt.
# Missing/stale/duplicate prices block requests. Example values are TEST ONLY.
MONSTERA_ALPHA_PROVIDER_PRICES_JSON=
# Integer micro-USD/day ceiling for conservative estimated Redis reservations.
# This estimate is NOT provider billing data or a guaranteed external spending cap.
MONSTERA_ALPHA_ESTIMATED_MICRO_USD_PER_DAY=

# Offline staging inspection: this label is not proof that a DB is nonproduction.
MONSTERA_STAGING_ONLY=false
MONSTERA_EXPECTED_TEST_DB_NAME=


# 개발/격리 테스트 전용: 프로덕션에서는 코드 차원에서 거부한다.
# 값이 false/미설정이면 기존 무료 알파에 크레딧 차감이 발생하지 않는다.
MONSTERA_INTERNAL_CREDIT_TEST_MODE=false
# 개발/격리 테스트 전용 수동 만료 예약 회수 API의 강한 인증키. 커밋 금지.
MONSTERA_RECLAIM_OPERATOR_KEY=
