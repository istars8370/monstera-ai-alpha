# 서버 전용 값. NEXT_PUBLIC_ 접두사 금지.
ALPHA_BASIC_USER=alpha
ALPHA_BASIC_PASSWORD=change-to-a-long-random-password
OPENROUTER_API_KEY=
ALPHA_MODEL_ID=

# Explicit server-side provider selection; CI uses only Mock calls
# Venice private means vendor non-retention policy; it is NOT end-to-end encryption.
ALPHA_CHAT_PROVIDER=venice
VENICE_API_KEY=
VENICE_PRIVATE_MODEL_ID=


# Optional comma-separated operator allowlist; each model is checked against the live Private catalog.
VENICE_PRIVATE_MODEL_IDS=
NEXT_TELEMETRY_DISABLED=1
